# nix
.direnv/

# external kernel source clone (reproducible: see shell.nix / notes for the
# git clone command, branch taoyao-s-oss)
kernel-taoyao/

# external device tree source clone (reproducible: see README, same
# taoyao-s-oss branch, repo MiCode/kernel_devicetree)
kernel-devicetree-taoyao/

# build outputs (Image, merged dtb) — reproducible from the two clones
