# Maintainer: Jens Reidel <adrian@travitia.xyz>
# Reference: <https://postmarketos.org/devicepkg>

pkgname=firmware-xiaomi-taoyao
pkgver=1
pkgrel=0
pkgdesc="Firmware for Xiaomi 12 Lite 5G"
subpackages="
	$pkgname-adsp
	$pkgname-cdsp
	$pkgname-gpu
	$pkgname-ipa
	$pkgname-modem
	$pkgname-sensors
	$pkgname-vpu
	$pkgname-wpss
	"
url="https://github.com/zstas/firmware-xiaomi-taoyao"
arch="aarch64"
license="proprietary"
options="!check !strip !archcheck !tracedeps pmb:cross-native"
_commit="fb9b96ddd6e96398d9d70563f71f15a85dac9566"
source="
	$pkgname-$_commit.tar.gz::$url/archive/$_commit/$pkgname-$_commit.tar.gz
	adsp.files
	cdsp.files
	gpu.files
	ipa.files
	modem.files
	sensors.files
	vpu.files
	wpss.files
"
builddir="$srcdir/$pkgname-$_commit"

package() {
	# parent package is empty
	mkdir -p "$pkgdir"
}

# Helper method for installing firmware files from a text file
install_files() {
	cd "$builddir"

	while IFS="" read -r _i || [ -n "$_i" ]; do
		[ ! -d $(dirname $_i) ] && mkdir -p $(dirname $_i)
		echo $_i
		install -Dm644 $_i "$subpkgdir/$_i"
	done < "$srcdir/$1"
}

adsp() {
	pkgdesc="Xiaomi 12 Lite 5G adsp firmware"

	mkdir "$subpkgdir"
	install_files "adsp.files"
}

cdsp() {
	pkgdesc="Xiaomi 12 Lite 5G cdsp firmware"

	mkdir "$subpkgdir"
	install_files "cdsp.files"
}

gpu() {
	pkgdesc="Xiaomi 12 Lite 5G gpu firmware"

	mkdir "$subpkgdir"
	install_files "gpu.files"
}

ipa() {
	pkgdesc="Xiaomi 12 Lite 5G ipa firmware"

	mkdir "$subpkgdir"
	install_files "ipa.files"
}

modem() {
	pkgdesc="Xiaomi 12 Lite 5G modem firmware"

	mkdir "$subpkgdir"
	install_files "modem.files"
}

sensors() {
	pkgdesc="Xiaomi 12 Lite 5G sensors firmware"

	mkdir "$subpkgdir"
	install_files "sensors.files"

	# Remove files that we don't need - for now
	rm -r "$subpkgdir"/usr/share/qcom/sm7325/Xiaomi/taoyao/acdb/
	rm -r "$subpkgdir"/usr/share/qcom/sm7325/Xiaomi/taoyao/dsp/

	find "$subpkgdir/usr/share/qcom/sm7325/Xiaomi/taoyao/" \
		-type f -exec chmod 0644 {} \;
}

vpu() {
	pkgdesc="Xiaomi 12 Lite 5G vpu firmware"

	mkdir "$subpkgdir"
	install_files "vpu.files"
}

wpss() {
	pkgdesc="Xiaomi 12 Lite 5G wpss firmware"

	mkdir "$subpkgdir"
	install_files "wpss.files"
}


